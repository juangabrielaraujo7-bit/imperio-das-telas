---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import FinalCta from '../components/FinalCta.astro';
import { services, neighborhoods } from '../data/business';

const service = services.find((s) => s.slug === 'troca-de-conector-de-carga')!;
---

<Layout title={service.metaTitle} description={service.metaDescription}>
  <PageHero
    eyebrow="Serviço"
    h1={service.h1}
    intro={service.intro}
    whatsappMessage={service.whatsappMessage}
    signsLabel={service.signsLabel}
    signs={service.signs}
  />

  <RelatedLinks
    title="Outros serviços"
    items={services.filter((s) => s.slug !== service.slug).map((s) => ({ href: `/${s.slug}`, label: s.title }))}
  />

  <RelatedLinks
    title="Atendemos também"
    items={neighborhoods.map((n) => ({ href: `/${n.slug}`, label: n.name }))}
  />

  <FinalCta whatsappMessage={service.whatsappMessage} />
</Layout>
