---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import FinalCta from '../components/FinalCta.astro';
import { brands, services } from '../data/business';

const brand = brands.find((b) => b.slug === 'assistencia-tecnica-xiaomi')!;
---

<Layout title={brand.metaTitle} description={brand.metaDescription}>
  <PageHero
    eyebrow="Marca atendida"
    h1={brand.h1}
    intro={brand.intro}
    whatsappMessage={brand.whatsappMessage}
  />

  <RelatedLinks
    title="Serviços para Xiaomi, Redmi e POCO"
    items={services.map((s) => ({ href: `/${s.slug}`, label: s.title }))}
  />

  <RelatedLinks
    title="Outras marcas atendidas"
    items={brands.filter((b) => b.slug !== brand.slug).map((b) => ({ href: `/${b.slug}`, label: b.name }))}
  />

  <FinalCta whatsappMessage={brand.whatsappMessage} />
</Layout>
