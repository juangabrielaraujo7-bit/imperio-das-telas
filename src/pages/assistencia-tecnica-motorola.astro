---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SelectorCta from '../components/SelectorCta.astro';
import PageGallery from '../components/PageGallery.astro';
import StoreShowcase from '../components/StoreShowcase.astro';
import PageFaq from '../components/PageFaq.astro';
import PageLinks from '../components/PageLinks.astro';
import { brands, problemOptions } from '../data/business';

const brand = brands.find((b) => b.slug === 'assistencia-tecnica-motorola')!;
---

<Layout title={brand.metaTitle} description={brand.metaDescription}>
  <PageHero
    eyebrow="Marca atendida"
    h1={brand.h1}
    intro={brand.intro}
    whatsappMessage={brand.whatsappMessage}
    signsLabel={brand.commonRepairsLabel}
    signs={brand.commonRepairs}
  />

  <SelectorCta
    heading="Qual o problema do seu Motorola?"
    helper="Selecione e já chame direto no WhatsApp."
    options={problemOptions}
    placeholder="Selecione o problema"
    messageTemplate="Olá! Meu Motorola está com o seguinte problema: {option}. Quero um orçamento."
  />

  <PageGallery
    text="Cada aparelho é testado antes de sair da loja, com atenção aos detalhes que fazem diferença num Motorola: vedação, encaixe da tela e calibração da câmera."
  />

  <StoreShowcase whatsappMessage={brand.whatsappMessage} />

  <PageFaq title="Dúvidas sobre conserto de Motorola" faqs={brand.faqs} />

  <PageLinks
    items={[
      { href: '/#marcas', label: 'Ver todas as marcas' },
      { href: '/#servicos', label: 'Todos os serviços' },
      { href: '/#localizacao', label: 'Onde fica a loja' },
    ]}
  />
</Layout>
