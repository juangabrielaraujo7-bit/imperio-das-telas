---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SelectorCta from '../components/SelectorCta.astro';
import PageGallery from '../components/PageGallery.astro';
import StoreShowcase from '../components/StoreShowcase.astro';
import PageFaq from '../components/PageFaq.astro';
import PageLinks from '../components/PageLinks.astro';
import { services, brandOptions } from '../data/business';

const service = services.find((s) => s.slug === 'troca-de-bateria')!;
---

<Layout title={service.metaTitle} description={service.metaDescription}>
  <PageHero
    eyebrow="Serviço"
    h1={service.h1}
    intro={service.intro}
    whatsappMessage={service.whatsappMessage}
    signsLabel={service.signsLabel}
    signs={service.signs}
  />

  <SelectorCta
    heading="Qual a marca do seu aparelho?"
    helper="Selecione e já chame direto no WhatsApp."
    options={brandOptions}
    placeholder="Selecione a marca"
    messageTemplate="Olá! Meu aparelho é {option} e quero um orçamento para troca de bateria."
  />

  <PageGallery
    text="Cada bateria é testada antes de sair da loja. É assim que garantimos que o aparelho volta pra sua mão funcionando de verdade."
  />

  <StoreShowcase whatsappMessage={service.whatsappMessage} />

  <PageFaq title="Dúvidas sobre a troca de bateria" faqs={service.faqs} />

  <PageLinks
    items={[
      { href: '/#servicos', label: 'Ver todos os serviços' },
      { href: '/#marcas', label: 'Marcas atendidas' },
      { href: '/#localizacao', label: 'Onde fica a loja' },
    ]}
  />
</Layout>
