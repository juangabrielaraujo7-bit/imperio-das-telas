---
import Icon from './Icon.astro';

const steps = [
  {
    n: '01',
    icon: 'phone',
    title: 'Fale com a gente',
    text: 'Chame no WhatsApp e conte o que está acontecendo com o seu aparelho.',
  },
  {
    n: '02',
    icon: 'search',
    title: 'Diagnóstico gratuito',
    text: 'Avaliamos o aparelho e identificamos a causa real do problema, sem custo.',
  },
  {
    n: '03',
    icon: 'receipt',
    title: 'Orçamento sem compromisso',
    text: 'Você recebe o valor exato antes de aprovar qualquer serviço.',
  },
  {
    n: '04',
    icon: 'shield',
    title: 'Reparo com garantia',
    text: 'Executamos o conserto com peças de qualidade e garantia no serviço.',
  },
];
---

<section class="section" id="como-funciona">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Como funciona</span>
      <h2>Do primeiro contato ao aparelho na sua mão</h2>
    </div>

    <div class="steps">
      {steps.map((step, i) => (
        <>
          <div class="step reveal" style={`--reveal-delay: ${i * 100}ms`}>
            <span class="step-icon"><Icon name={step.icon} size={20} /></span>
            <span class="step-n">{step.n}</span>
            <div class="step-body">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </div>
          {i < steps.length - 1 && (
            <div class="step-connector" aria-hidden="true">
              <span class="step-connector-icon"><Icon name="arrow" size={16} /></span>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: 1fr 28px 1fr 28px 1fr 28px 1fr;
    align-items: start;
  }

  .step-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    color: var(--silver);
  }

  .step-connector-icon {
    display: flex;
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    margin-bottom: 18px;
  }

  .step-n {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--silver);
    margin-bottom: 14px;
    letter-spacing: 0.04em;
  }

  .step-body h3 {
    font-size: 1.05rem;
    margin-bottom: 8px;
  }

  .step-body p {
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .step-connector {
      justify-content: flex-start;
      height: auto;
      padding: 10px 0 10px 12px;
    }

    .step-connector-icon {
      rotate: 90deg;
    }
  }
</style>
