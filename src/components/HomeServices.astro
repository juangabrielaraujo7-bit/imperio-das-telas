---
import { services, whatsappLink } from '../data/business';
import Icon from './Icon.astro';
---

<section class="section" id="servicos">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Serviços</span>
      <h2>Reparo especializado para o seu aparelho</h2>
      <p>Diagnóstico gratuito e orçamento sem compromisso antes de qualquer serviço.</p>
    </div>

    <div class="grid grid-3">
      {services.map((service, i) => (
        <article class="card surface reveal" style={`--reveal-delay: ${Math.min(i * 70, 280)}ms`}>
          <div class={`card-media media-${service.imageType}`} data-photo>
            {service.imageType === 'cutout' && <span class="media-glow" aria-hidden="true" />}
            <img
              class={service.imageType === 'photo' ? 'media-photo' : ''}
              src={service.image}
              alt={service.imageAlt}
              loading="lazy"
              width="360"
              height="280"
              style={service.imageType === 'cutout' ? `animation-delay: ${i * 300}ms` : ''}
            />
            <span class="card-icon" data-photo-fallback>
              <Icon name={service.icon} size={19} />
            </span>
          </div>

          <div class="card-body">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="card-actions">
              <a class="details" href={`/${service.slug}`}>Ver detalhes</a>
              <a class="wa-link" href={whatsappLink(service.whatsappMessage)} target="_blank" rel="noopener noreferrer nofollow">
                WhatsApp
              </a>
            </div>
          </div>
        </article>
      ))}

      <article class="card surface reveal" style={`--reveal-delay: ${Math.min(services.length * 70, 280)}ms`}>
        <div class="card-media media-photo" data-photo>
          <img
            class="media-photo"
            src="/img/servicos/outros-defeitos.jpg"
            alt="Detalhe interno de celular aberto para reparo"
            loading="lazy"
            width="360"
            height="280"
          />
          <span class="card-icon" data-photo-fallback>
            <Icon name="other" size={19} />
          </span>
        </div>

        <div class="card-body">
          <h3>Outros defeitos</h3>
          <p>Alto-falante, microfone, botões, conector de fone e outros reparos.</p>
          <div class="card-actions">
            <a class="wa-link" href={whatsappLink('Olá! Vim pelo site e tenho outro defeito no meu aparelho, gostaria de um orçamento.')} target="_blank" rel="noopener noreferrer nofollow">
              Falar no WhatsApp
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .card {
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1), border-color var(--transition), box-shadow var(--transition);
  }

  .card:hover {
    transform: translateY(-10px);
    border-color: var(--ink);
    box-shadow: var(--shadow-md);
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 152px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .media-cutout,
  .media-icon-only {
    background: var(--bg);
  }

  .media-glow {
    position: absolute;
    width: 68%;
    height: 38px;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
    background: radial-gradient(ellipse at center, rgba(10, 10, 12, 0.18) 0%, rgba(10, 10, 12, 0) 72%);
    pointer-events: none;
  }

  .media-cutout img {
    position: relative;
    max-width: 74%;
    max-height: 80%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 12px rgba(10, 10, 12, 0.18));
    animation: card-float 3.6s ease-in-out infinite;
  }

  @keyframes card-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media-cutout img {
      animation: none;
    }
  }

  .media-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .card:hover .media-photo {
    transform: scale(1.07);
  }

  .media-icon-only img {
    display: none;
  }

  .card-icon {
    position: absolute;
    left: 18px;
    bottom: -16px;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 18px rgba(10, 10, 12, 0.25);
    border: 3px solid var(--surface);
    z-index: 1;
    transition: transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1), background 250ms ease;
  }

  .card-icon.is-plain {
    position: static;
    border: none;
    box-shadow: none;
  }

  .card-media.no-media img,
  .card-media.no-media .media-glow {
    display: none;
  }

  .card-media.no-media .card-icon {
    position: static;
    border: none;
    box-shadow: none;
  }

  .card:hover .card-icon {
    transform: rotate(-10deg) scale(1.12);
    background: var(--whatsapp);
  }

  .card-body {
    padding: 30px 24px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-body h3 {
    margin-bottom: 8px;
  }

  .card-body p {
    margin-bottom: 20px;
    font-size: 0.92rem;
    flex: 1;
  }

  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .details {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
  }

  .wa-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-2);
    transition: color var(--transition);
  }

  .wa-link:hover {
    color: var(--ink);
  }
</style>

<script>
  document.querySelectorAll('[data-photo]').forEach((media) => {
    const img = media.querySelector('img');
    if (!img) return;

    const markNoMedia = () => media.classList.add('no-media');

    if (img.complete && img.naturalWidth === 0) {
      markNoMedia();
      return;
    }

    img.addEventListener('error', markNoMedia, { once: true });
  });
</script>
