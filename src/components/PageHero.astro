---
import WhatsappCta from './WhatsappCta.astro';
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  h1: string;
  intro: string;
  whatsappMessage: string;
  signsLabel?: string;
  signs?: string[];
}

const { eyebrow, h1, intro, whatsappMessage, signsLabel, signs } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{h1}</h1>
    <p class="lead">{intro}</p>
    <WhatsappCta message={whatsappMessage} />

    {signs && signs.length > 0 && (
      <div class="signs surface reveal">
        <h2>{signsLabel}</h2>
        <ul>
          {signs.map((sign) => (
            <li>
              <span class="check-badge"><Icon name="check" size={13} /></span>
              <span>{sign}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    padding: 64px 0 88px;
    border-bottom: 1px solid var(--line);
  }

  .lead {
    max-width: 640px;
    font-size: 1.05rem;
    margin-bottom: 28px;
  }

  .signs {
    margin-top: 48px;
    padding: 32px;
    max-width: 560px;
    border-left: 3px solid var(--ink);
  }

  .signs h2 {
    font-size: 1.1rem;
    margin-bottom: 18px;
  }

  .signs ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .signs li {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink-2);
    font-weight: 500;
  }

  .check-badge {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
