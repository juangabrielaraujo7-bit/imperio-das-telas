---
import WhatsappCta from './WhatsappCta.astro';
---

<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-title reveal reveal-left">Tela trincada, bateria fraca ou celular que não liga? A gente resolve.</h1>

    <div class="hero-device reveal reveal-right" style="--reveal-delay: 120ms" aria-hidden="true">
      <div class="flip-stage">
        <div class="flip-card">
          <div class="flip-face flip-front">
            <div class="device-frame">
              <div class="device-notch"></div>
              <div class="device-screen is-broken">
                <svg class="crack" viewBox="0 0 100 180" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M50 0 L46 38 L60 52 L44 70 L58 90 L38 108 L52 130 L40 150 L50 180" />
                  <path d="M46 38 L20 30 M46 38 L14 55 M60 52 L86 44 M60 52 L90 66 M44 70 L18 78 M58 90 L82 100 M38 108 L12 120 M52 130 L78 140 M40 150 L16 162" />
                </svg>
              </div>
            </div>
          </div>
          <div class="flip-face flip-back">
            <div class="device-frame">
              <div class="device-notch"></div>
              <div class="device-screen">
                <div class="screen-line"></div>
                <div class="screen-line short"></div>
                <div class="screen-chip"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-copy reveal reveal-left" style="--reveal-delay: 80ms">
      <p class="lead">
        Atendemos Freguesia do Ó, Vila Palmeiras, Limão, Casa Verde, Brasilândia e Cachoeirinha.
      </p>
      <div class="hero-actions">
        <WhatsappCta message="Olá! Vim pelo site e gostaria de um orçamento." pulse />
        <a class="btn btn-secondary" href="#servicos">Ver serviços</a>
      </div>

      <div class="hero-proof">
        <strong>+[NÚMERO]</strong>
        <span>aparelhos reparados na região</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 96px;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    grid-template-areas:
      'title device'
      'copy device';
    align-items: center;
    column-gap: 48px;
    row-gap: 8px;
  }

  .hero-title {
    grid-area: title;
    align-self: end;
  }

  .hero-copy {
    grid-area: copy;
    align-self: start;
  }

  .hero-copy .lead {
    max-width: 520px;
    font-size: 1.08rem;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .hero-proof {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .hero-proof strong {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-proof span {
    color: var(--ink-2);
    font-size: 0.9rem;
  }

  .hero-device {
    grid-area: device;
    display: flex;
    justify-content: center;
  }

  .flip-stage {
    perspective: 1500px;
    width: 260px;
    height: 520px;
  }

  .flip-card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    animation: phone-flip 7s cubic-bezier(0.65, 0.05, 0.36, 1) infinite;
  }

  @keyframes phone-flip {
    0%,
    40% {
      transform: rotateY(0deg);
    }
    50% {
      transform: rotateY(180deg);
    }
    90% {
      transform: rotateY(180deg);
    }
    100% {
      transform: rotateY(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-card {
      animation: none;
    }
  }

  .flip-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-back {
    transform: rotateY(180deg);
  }

  .device-frame {
    width: 100%;
    height: 100%;
    border-radius: 42px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px rgba(18, 18, 20, 0.08);
    padding: 18px;
    position: relative;
  }

  .device-notch {
    width: 90px;
    height: 20px;
    background: var(--ink);
    border-radius: 999px;
    margin: 0 auto 24px;
  }

  .device-screen {
    height: calc(100% - 60px);
    border-radius: 26px;
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 24px 18px;
    position: relative;
    overflow: hidden;
  }

  .screen-line {
    height: 10px;
    border-radius: 6px;
    background: var(--line);
    margin-bottom: 12px;
    width: 100%;
  }

  .screen-line.short {
    width: 60%;
  }

  .screen-chip {
    margin-top: 28px;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--ink);
  }

  .device-screen.is-broken {
    background: #1c1c1f;
  }

  .crack {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgba(255, 255, 255, 0.55);
    stroke-width: 0.8;
    stroke-linecap: round;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'title'
        'device'
        'copy';
      row-gap: 28px;
    }

    .hero-title,
    .hero-copy {
      align-self: auto;
    }

    .flip-stage {
      width: 200px;
      height: 400px;
    }
  }
</style>
