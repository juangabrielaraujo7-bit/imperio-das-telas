---
import WhatsappCta from './WhatsappCta.astro';
---

<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-title reveal reveal-left">Tela trincada, bateria fraca ou celular que não liga? A gente resolve.</h1>

    <div class="hero-device reveal reveal-right" style="--reveal-delay: 120ms" aria-hidden="true">
      <div class="flip-stage">
        <div class="flip-card">
          <div class="flip-face flip-front">
            <span class="device-glow" aria-hidden="true"></span>
            <img src="/hero/celular-quebrado.webp" alt="" loading="eager" width="1024" height="1024" />
          </div>
          <div class="flip-face flip-back">
            <span class="device-glow" aria-hidden="true"></span>
            <img src="/hero/celular-novo.webp" alt="" loading="eager" width="1024" height="1024" />
          </div>
        </div>
      </div>
    </div>

    <div class="hero-copy reveal reveal-left" style="--reveal-delay: 80ms">
      <p class="lead">
        Atendemos Freguesia do Ó, Vila Palmeiras, Limão, Casa Verde, Brasilândia e Cachoeirinha.
      </p>
      <div class="hero-actions">
        <WhatsappCta message="Olá! Vim pelo site e gostaria de um orçamento." pulse />
        <a class="btn btn-secondary" href="#servicos">Ver serviços</a>
      </div>

      <div class="hero-proof">
        <strong>+[NÚMERO]</strong>
        <span>aparelhos reparados na região</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 96px;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    grid-template-areas:
      'title device'
      'copy device';
    align-items: center;
    column-gap: 48px;
    row-gap: 8px;
  }

  .hero-title {
    grid-area: title;
    align-self: end;
  }

  .hero-copy {
    grid-area: copy;
    align-self: start;
  }

  .hero-copy .lead {
    max-width: 520px;
    font-size: 1.08rem;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .hero-proof {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .hero-proof strong {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-proof span {
    color: var(--ink-2);
    font-size: 0.9rem;
  }

  .hero-device {
    grid-area: device;
    display: flex;
    justify-content: center;
  }

  .flip-stage {
    perspective: 1500px;
    width: 460px;
    height: 460px;
  }

  .flip-card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    animation: phone-flip 7s cubic-bezier(0.65, 0.05, 0.36, 1) infinite;
  }

  @keyframes phone-flip {
    0%,
    40% {
      transform: rotateY(0deg);
    }
    50% {
      transform: rotateY(180deg);
    }
    90% {
      transform: rotateY(180deg);
    }
    100% {
      transform: rotateY(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-card {
      animation: none;
    }
  }

  .flip-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-back {
    transform: rotateY(180deg);
  }

  .flip-face img {
    position: relative;
    width: 94%;
    height: 94%;
    object-fit: contain;
    filter: drop-shadow(0 26px 28px rgba(10, 10, 12, 0.22));
  }

  .device-glow {
    position: absolute;
    width: 60%;
    height: 40px;
    left: 50%;
    bottom: 8%;
    translate: -50% 0;
    background: radial-gradient(ellipse at center, rgba(10, 10, 12, 0.2) 0%, rgba(10, 10, 12, 0) 72%);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'title'
        'device'
        'copy';
      row-gap: 28px;
    }

    .hero-title,
    .hero-copy {
      align-self: auto;
    }

    .flip-stage {
      width: 340px;
      height: 340px;
    }
  }
</style>
