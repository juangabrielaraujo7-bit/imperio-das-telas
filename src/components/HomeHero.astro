---
import WhatsappCta from './WhatsappCta.astro';
---

<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-title reveal reveal-left">Seu celular quebrou?<br />A Império das Telas resolve.</h1>

    <div class="hero-device reveal reveal-right" style="--reveal-delay: 120ms" aria-hidden="true">
      <span class="hero-smoke" aria-hidden="true"></span>
      <div class="flip-stage">
        <div class="flip-card">
          <div class="flip-face flip-front">
            <span class="device-glow" aria-hidden="true"></span>
            <img src="/hero/celular-quebrado.webp" alt="" loading="eager" width="1024" height="1024" />
          </div>
          <div class="flip-face flip-back">
            <span class="device-glow" aria-hidden="true"></span>
            <img src="/hero/celular-novo.webp" alt="" loading="eager" width="1024" height="1024" />
          </div>
        </div>
      </div>
    </div>

    <div class="hero-copy reveal reveal-left" style="--reveal-delay: 80ms">
      <div class="hero-actions">
        <WhatsappCta message="Olá! Vim pelo site e gostaria de um orçamento." pulse />
        <a class="btn btn-secondary" href="#servicos">Ver serviços</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 96px;
    border-bottom: 1px solid var(--line);
    overflow-x: hidden;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    grid-template-areas:
      'title device'
      'copy device';
    align-items: center;
    column-gap: 32px;
    row-gap: 8px;
  }

  /* Smoke cloud anchored to the phone, leaning slightly toward the text
     side (left) so the copy reads as if it drifts into the device —
     an implied line of sight without drawing an actual arrow.
     Grayscale only (black fading into the page), fixed pixel size so
     it never stretches with the section's height on mobile. */
  .hero-smoke {
    position: absolute;
    z-index: 0;
    width: 900px;
    height: 900px;
    left: 38%;
    top: 50%;
    translate: -50% -50%;
    pointer-events: none;
    filter: blur(60px);
    background:
      radial-gradient(circle at 62% 42%, rgba(8, 8, 10, 0.97) 0%, rgba(8, 8, 10, 0.82) 14%, rgba(8, 8, 10, 0) 40%),
      radial-gradient(circle at 50% 64%, rgba(18, 18, 20, 0.82) 0%, rgba(18, 18, 20, 0) 42%),
      radial-gradient(circle at 70% 26%, rgba(28, 28, 31, 0.6) 0%, rgba(28, 28, 31, 0) 38%),
      radial-gradient(circle at 44% 50%, rgba(38, 38, 41, 0.46) 0%, rgba(38, 38, 41, 0) 42%),
      radial-gradient(circle at 30% 58%, rgba(60, 60, 63, 0.3) 0%, rgba(60, 60, 63, 0) 46%),
      radial-gradient(circle at 74% 66%, rgba(15, 15, 17, 0.5) 0%, rgba(15, 15, 17, 0) 40%);
  }

  .hero-title {
    grid-area: title;
    align-self: end;
    position: relative;
    z-index: 1;
    max-width: 15ch;
  }

  .hero-copy {
    grid-area: copy;
    align-self: start;
    position: relative;
    z-index: 1;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-device {
    grid-area: device;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flip-stage {
    position: relative;
    z-index: 1;
    perspective: 1500px;
    width: 460px;
    height: 460px;
    animation: device-float 4.2s ease-in-out infinite;
  }

  .flip-card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    animation: phone-flip 6s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  /* Hold on "broken" so it's clearly visible before the first flip,
     then a quick 1.5s turn into the "fixed" state. */
  @keyframes phone-flip {
    0%,
    40% {
      transform: rotateY(0deg);
    }
    65% {
      transform: rotateY(180deg);
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    90% {
      transform: rotateY(180deg);
    }
    100% {
      transform: rotateY(360deg);
    }
  }

  @keyframes device-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-card,
    .flip-stage {
      animation: none;
    }
  }

  .flip-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-back {
    transform: rotateY(180deg);
  }

  .flip-face img {
    position: relative;
    width: 94%;
    height: 94%;
    object-fit: contain;
    filter: drop-shadow(0 26px 28px rgba(10, 10, 12, 0.35));
  }

  .device-glow {
    position: absolute;
    width: 60%;
    height: 40px;
    left: 50%;
    bottom: 8%;
    translate: -50% 0;
    background: radial-gradient(ellipse at center, rgba(10, 10, 12, 0.28) 0%, rgba(10, 10, 12, 0) 72%);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'title'
        'device'
        'copy';
      row-gap: 28px;
    }

    .hero-title,
    .hero-copy {
      align-self: auto;
    }

    .hero-title {
      max-width: none;
    }

    .hero-copy {
      margin-top: 14px;
    }

    .hero-smoke {
      width: 620px;
      height: 620px;
      left: 50%;
      filter: blur(40px);
    }

    .flip-stage {
      width: 340px;
      height: 340px;
    }
  }
</style>
