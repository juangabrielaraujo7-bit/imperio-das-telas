---
import WhatsappCta from './WhatsappCta.astro';
---

<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-title reveal reveal-left">Seu celular quebrou? A Império das Telas resolve.</h1>

    <div class="hero-device reveal reveal-right" style="--reveal-delay: 120ms" aria-hidden="true">
      <span class="device-backdrop" aria-hidden="true"></span>
      <div class="flip-stage">
        <div class="flip-card">
          <div class="flip-face flip-front">
            <span class="device-glow" aria-hidden="true"></span>
            <img src="/hero/celular-quebrado.webp" alt="" loading="eager" width="1024" height="1024" />
          </div>
          <div class="flip-face flip-back">
            <span class="device-glow" aria-hidden="true"></span>
            <img src="/hero/celular-novo.webp" alt="" loading="eager" width="1024" height="1024" />
          </div>
        </div>
      </div>
    </div>

    <div class="hero-copy reveal reveal-left" style="--reveal-delay: 80ms">
      <div class="hero-actions">
        <WhatsappCta message="Olá! Vim pelo site e gostaria de um orçamento." pulse />
        <a class="btn btn-secondary" href="#servicos">Ver serviços</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 96px;
    border-bottom: 1px solid var(--line);
    overflow-x: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    grid-template-areas:
      'title device'
      'copy device';
    align-items: center;
    column-gap: 48px;
    row-gap: 8px;
  }

  .hero-title {
    grid-area: title;
    align-self: end;
  }

  .hero-copy {
    grid-area: copy;
    align-self: start;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-device {
    grid-area: device;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .device-backdrop {
    position: absolute;
    z-index: 0;
    width: 640px;
    height: 640px;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      rgba(10, 10, 12, 0.92) 0%,
      rgba(10, 10, 12, 0.7) 22%,
      rgba(10, 10, 12, 0.36) 42%,
      rgba(10, 10, 12, 0.12) 60%,
      rgba(10, 10, 12, 0) 78%
    );
    pointer-events: none;
  }

  .flip-stage {
    position: relative;
    z-index: 1;
    perspective: 1500px;
    width: 460px;
    height: 460px;
    animation: device-float 4.2s ease-in-out infinite;
  }

  .flip-card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    animation: phone-flip 10s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  /* Longer hold on "broken" so it's clearly visible before the first flip,
     then a slow, deliberate turn (suspense) into the "fixed" state. */
  @keyframes phone-flip {
    0%,
    52% {
      transform: rotateY(0deg);
    }
    68% {
      transform: rotateY(180deg);
      animation-timing-function: cubic-bezier(0.83, 0, 0.17, 1);
    }
    92% {
      transform: rotateY(180deg);
    }
    100% {
      transform: rotateY(360deg);
    }
  }

  @keyframes device-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-card,
    .flip-stage {
      animation: none;
    }
  }

  .flip-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-back {
    transform: rotateY(180deg);
  }

  .flip-face img {
    position: relative;
    width: 94%;
    height: 94%;
    object-fit: contain;
    filter: drop-shadow(0 26px 28px rgba(10, 10, 12, 0.35));
  }

  .device-glow {
    position: absolute;
    width: 60%;
    height: 40px;
    left: 50%;
    bottom: 8%;
    translate: -50% 0;
    background: radial-gradient(ellipse at center, rgba(10, 10, 12, 0.28) 0%, rgba(10, 10, 12, 0) 72%);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'title'
        'device'
        'copy';
      row-gap: 28px;
    }

    .hero-title,
    .hero-copy {
      align-self: auto;
    }

    .device-backdrop {
      width: 440px;
      height: 440px;
    }

    .flip-stage {
      width: 340px;
      height: 340px;
    }
  }
</style>
