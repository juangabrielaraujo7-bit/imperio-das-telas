---
interface LinkItem {
  href: string;
  label: string;
}

interface Props {
  items: LinkItem[];
}

const { items } = Astro.props;
---

<section class="page-links">
  <div class="container">
    <ul>
      {items.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .page-links {
    padding: 8px 0 56px;
  }

  .page-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .page-links a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-2);
    transition: border-color var(--transition), color var(--transition);
  }

  .page-links a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
</style>
