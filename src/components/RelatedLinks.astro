---
interface LinkItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  items: LinkItem[];
}

const { title, items } = Astro.props;
---

<section class="related">
  <div class="container">
    <h2>{title}</h2>
    <ul>
      {items.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .related {
    padding: 56px 0;
    border-bottom: 1px solid var(--line);
  }

  .related h2 {
    font-size: 1.15rem;
    margin-bottom: 20px;
  }

  .related ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .related a {
    display: inline-block;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--ink-2);
    transition: border-color var(--transition), color var(--transition);
  }

  .related a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
</style>
