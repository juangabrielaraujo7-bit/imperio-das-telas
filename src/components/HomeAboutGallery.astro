---
const videos = [
  {
    file: 'bancada-servico.mp4',
    poster: 'bancada-servico.jpg',
    alt: 'Técnico realizando reparo de celular na bancada da Império das Telas',
    hasAudio: false,
  },
  {
    file: 'loja-profissional.mp4',
    poster: 'loja-profissional.jpg',
    alt: 'Técnico da Império das Telas apresentando a loja, com áudio',
    hasAudio: true,
  },
];

---

<section class="section" id="sobre">
  <div class="container">
    <div class="about-grid">
      <div class="about-copy reveal">
        <span class="eyebrow">Sobre a loja</span>
        <h2>Uma bancada de verdade, no coração da Freguesia do Ó</h2>
        <p>
          Somos uma assistência técnica local, especializada em celulares, com diagnóstico honesto e peças de
          qualidade. Conheça um pouco da nossa loja e da nossa bancada de reparo, onde cada aparelho é tratado
          com cuidado técnico.
        </p>
      </div>
    </div>

    <div class="grid grid-2 gallery">
      {videos.map((video, i) => (
        <div class="media surface reveal reveal-scale" style={`--reveal-delay: ${i * 90}ms`} data-media data-video-card>
          <video
            class="media-content"
            muted={!video.hasAudio}
            loop={!video.hasAudio}
            controls={video.hasAudio}
            playsinline
            preload="metadata"
            poster={`/img/videos/${video.poster}`}
            data-src={`/videos/${video.file}`}
          >
            <source src={`/videos/${video.file}`} type="video/mp4" />
          </video>
          {!video.hasAudio && (
            <button class="video-play" type="button" aria-label="Reproduzir vídeo" data-play-btn>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </button>
          )}
          <span class="media-fallback" data-media-fallback>Vídeo em breve</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-copy {
    max-width: 620px;
    margin-bottom: 40px;
  }

  .gallery {
    margin-bottom: 24px;
  }

  .gallery:last-child {
    margin-bottom: 0;
  }

  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 0;
    background: var(--bg);
  }

  .media-content {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 500ms ease;
  }

  .media:hover .media-content {
    transform: scale(1.04);
  }

  .media-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--silver);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .media.no-media .media-content {
    display: none;
  }

  .media.no-media .media-fallback {
    display: flex;
  }

  .video-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(10, 10, 12, 0.55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    padding: 0;
    cursor: pointer;
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    transition: opacity var(--transition), background var(--transition), transform var(--transition);
  }

  .video-play:hover {
    background: rgba(10, 10, 12, 0.75);
    transform: scale(1.06);
  }

  .media.is-playing .video-play {
    opacity: 0;
    pointer-events: none;
  }

  .media.no-media .video-play {
    display: none;
  }

  @media (max-width: 480px) {
    .grid-2.gallery {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-media]').forEach((card) => {
    const media = card.querySelector<HTMLImageElement | HTMLVideoElement>('.media-content');
    if (!media) return;

    const markNoMedia = () => card.classList.add('no-media');

    if (media instanceof HTMLVideoElement) {
      media.addEventListener('error', markNoMedia, { once: true });

      // Checking networkState right away is unreliable: the browser may not
      // have started (or finished) the resource selection algorithm yet,
      // especially for an off-screen video, which produced false positives.
      // Give it a few seconds to genuinely fail before treating it as missing.
      setTimeout(() => {
        const stillNothing = media.readyState === HTMLMediaElement.HAVE_NOTHING;
        const gaveUp = media.networkState === HTMLMediaElement.NETWORK_NO_SOURCE;
        if (media.error || (stillNothing && gaveUp)) markNoMedia();
      }, 5000);

      // Autoplay can silently fail on some phones/browsers. Without a manual
      // play button the video would look permanently frozen on the poster.
      const playBtn = card.querySelector<HTMLButtonElement>('[data-play-btn]');
      if (playBtn) {
        playBtn.addEventListener('click', () => {
          media.play().catch(() => {});
        });
        media.addEventListener('play', () => card.classList.add('is-playing'));
        media.addEventListener('pause', () => card.classList.remove('is-playing'));
      }
    } else {
      if (media.complete && media.naturalWidth === 0) {
        markNoMedia();
        return;
      }
      media.addEventListener('error', markNoMedia, { once: true });
    }
  });

  // Autoplay only the silent, looping videos when they scroll into view.
  if ('IntersectionObserver' in window) {
    const playObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.5 }
    );

    document.querySelectorAll<HTMLVideoElement>('[data-video-card] video[loop]').forEach((v) => playObserver.observe(v));
  }
</script>
