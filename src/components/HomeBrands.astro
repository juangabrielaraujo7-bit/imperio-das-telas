---
import { brands, whatsappLink } from '../data/business';
import Icon from './Icon.astro';
---

<section class="section" id="marcas">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Marcas atendidas</span>
      <h2>Trabalhamos com as principais marcas do mercado</h2>
    </div>

    <div class="grid grid-4">
      {brands.map((brand, i) => (
        <a class="brand-card surface reveal reveal-scale" style={`--reveal-delay: ${i * 70}ms`} href={`/${brand.slug}`}>
          <span class="brand-icon"><Icon name="phone" size={20} /></span>
          <span class="brand-name">{brand.name}</span>
          <span class="brand-link">Ver mais</span>
        </a>
      ))}

      <a
        class="brand-card surface reveal reveal-scale"
        style={`--reveal-delay: ${brands.length * 70}ms`}
        href={whatsappLink('Olá! Meu aparelho é de outra marca, gostaria de um orçamento.')}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >
        <span class="brand-icon"><Icon name="other" size={20} /></span>
        <span class="brand-name">Outras marcas</span>
        <span class="brand-link">Falar no WhatsApp</span>
      </a>
    </div>
  </div>
</section>

<style>
  .brand-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: 28px;
    min-height: 150px;
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1), border-color var(--transition), box-shadow var(--transition);
  }

  .brand-card:hover {
    transform: translateY(-10px) scale(1.02);
    border-color: var(--ink);
    box-shadow: var(--shadow-md);
  }

  .brand-card:hover .brand-icon {
    background: var(--whatsapp);
    color: #fff;
    transform: rotate(-10deg) scale(1.15);
  }

  .brand-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--silver);
    transition: background var(--transition), color var(--transition), transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .brand-name {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .brand-link {
    font-size: 0.85rem;
    color: var(--ink-2);
    font-weight: 600;
  }
</style>
