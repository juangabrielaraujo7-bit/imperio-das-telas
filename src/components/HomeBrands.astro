---
import { brands, whatsappLink } from '../data/business';
---

<section class="section" id="marcas">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Marcas atendidas</span>
      <h2>Trabalhamos com as principais marcas do mercado</h2>
    </div>

    <div class="grid grid-4">
      {brands.map((brand) => (
        <a class="brand-card surface reveal" href={`/${brand.slug}`}>
          <span class="brand-name">{brand.name}</span>
          <span class="brand-link">Ver mais →</span>
        </a>
      ))}

      <a
        class="brand-card surface reveal"
        href={whatsappLink('Olá! Meu aparelho é de outra marca, gostaria de um orçamento.')}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >
        <span class="brand-name">Outras marcas</span>
        <span class="brand-link">Falar no WhatsApp →</span>
      </a>
    </div>
  </div>
</section>

<style>
  .brand-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 28px;
    min-height: 140px;
    transition: transform var(--transition), border-color var(--transition);
  }

  .brand-card:hover {
    transform: translateY(-4px);
    border-color: var(--ink);
  }

  .brand-name {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .brand-link {
    font-size: 0.85rem;
    color: var(--ink-2);
    font-weight: 600;
  }
</style>
