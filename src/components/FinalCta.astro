---
import WhatsappCta from './WhatsappCta.astro';

interface Props {
  title?: string;
  subtitle?: string;
  whatsappMessage: string;
}

const {
  title = 'Fale agora com quem entende do assunto',
  subtitle = 'Diagnóstico gratuito e orçamento sem compromisso, direto no WhatsApp.',
  whatsappMessage,
} = Astro.props;
---

<section class="final-cta">
  <div class="container">
    <div class="box reveal">
      <h2>{title}</h2>
      <p>{subtitle}</p>
      <WhatsappCta message={whatsappMessage} />
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding: 72px 0;
  }

  .box {
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius);
    padding: 56px 40px;
    text-align: center;
  }

  .box h2 {
    color: #fff;
    max-width: 560px;
    margin: 0 auto 12px;
  }

  .box p {
    color: rgba(255, 255, 255, 0.68);
    max-width: 460px;
    margin: 0 auto 28px;
  }

  .box :global(.btn-primary) {
    background: #fff;
    color: var(--ink);
  }

  .box :global(.btn-primary:hover) {
    background: #eee;
  }
</style>
