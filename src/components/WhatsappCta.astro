---
import { whatsappLink } from '../data/business';

interface Props {
  message: string;
  label?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  class?: string;
}

const {
  message,
  label = 'Orçamento no WhatsApp',
  variant = 'primary',
  size = 'md',
  class: className = '',
} = Astro.props;

const cls = [
  'btn',
  variant === 'primary' ? 'btn-whatsapp' : 'btn-secondary',
  size === 'sm' ? 'btn-sm' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a
  class={cls}
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener noreferrer nofollow"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 3a9 9 0 0 0-7.75 13.55L3 21l4.6-1.2A9 9 0 1 0 12 3Zm5.2 12.9c-.2.6-1.2 1.2-1.7 1.3-.4.1-1 .2-3.1-.7-2.6-1.1-4.3-3.7-4.4-3.9-.1-.2-1-1.4-1-2.6 0-1.2.6-1.8.9-2.1.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.6.7 1.8s0 .3-.1.5c-.1.2-.2.3-.4.5-.1.2-.3.3-.1.6.2.4.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.7 1.6.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1l1.7.8c.2.1.4.2.5.3.1.2.1.9-.2 1.6Z"/>
  </svg>
  {label}
</a>
