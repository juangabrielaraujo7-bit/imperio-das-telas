---
import WhatsappCta from './WhatsappCta.astro';

const videos = [
  { id: 1, label: 'Troca de tela' },
  { id: 2, label: 'Troca de tampa traseira' },
  { id: 3, label: 'Aplicação de película hidrogel' },
];
---

<section class="section" id="antes-e-depois">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Antes e depois</span>
      <h2>Veja o resultado do nosso trabalho</h2>
      <p>Aparelhos reais, recuperados na nossa bancada.</p>
    </div>

    <div class="grid grid-3">
      {videos.map((v, i) => (
        <div class="video-card surface reveal reveal-scale" style={`--reveal-delay: ${i * 90}ms`} data-video-card>
          <div class="video-wrap">
            <video
              class="ba-video"
              muted
              loop
              playsinline
              preload="metadata"
              poster={`/img/videos/antes-depois-${v.id}.jpg`}
              data-src={`/videos/antes-depois-${v.id}.mp4`}
            >
              <source src={`/videos/antes-depois-${v.id}.mp4`} type="video/mp4" />
            </video>
            <button class="video-play" type="button" aria-label={`Reproduzir vídeo: ${v.label}`} data-play-btn>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </button>
            <span class="video-fallback" data-video-fallback>
              <span>Em breve</span>
            </span>
          </div>
          <div class="video-caption">
            <span>{v.label}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="ba-cta reveal">
      <WhatsappCta message="Olá! Vi os vídeos de antes e depois no site e gostaria de um orçamento." />
    </div>
  </div>
</section>

<style>
  .video-card {
    overflow: hidden;
    padding: 0;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .video-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .video-card:hover .ba-video {
    transform: scale(1.05);
  }

  .video-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--bg);
  }

  .ba-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .video-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(10, 10, 12, 0.55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    padding: 0;
    cursor: pointer;
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    transition: opacity var(--transition), background var(--transition), transform var(--transition);
  }

  .video-play:hover {
    background: rgba(10, 10, 12, 0.75);
    transform: scale(1.06);
  }

  .video-wrap.is-playing .video-play {
    opacity: 0;
    pointer-events: none;
  }

  .video-card.no-media .video-play {
    display: none;
  }

  .video-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--silver);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .video-card.no-media .video-fallback {
    display: flex;
  }

  .video-card.no-media .ba-video {
    display: none;
  }

  .video-caption {
    padding: 16px 20px;
    border-top: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .ba-cta {
    margin-top: 40px;
    display: flex;
    justify-content: center;
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-video-card]');

  cards.forEach((card) => {
    const video = card.querySelector('video');
    if (!video) return;

    const src = video.dataset.src;
    if (!src) return;

    const markNoMedia = () => card.classList.add('no-media');

    video.addEventListener('error', markNoMedia, { once: true });

    // Checking networkState right away is unreliable: the browser may not
    // have started (or finished) the resource selection algorithm yet,
    // especially for an off-screen video, which produced false positives.
    // Give it a few seconds to genuinely fail before treating it as missing.
    setTimeout(() => {
      const stillNothing = video.readyState === HTMLMediaElement.HAVE_NOTHING;
      const gaveUp = video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE;
      if (video.error || (stillNothing && gaveUp)) markNoMedia();
    }, 5000);

    // Autoplay can silently fail on some phones/browsers (data saver, in-app
    // browsers, stricter autoplay policies). Without a manual play button the
    // video would look permanently frozen on the poster with no way to start
    // it, so this button is always available as a reliable fallback.
    const wrap = card.querySelector('.video-wrap');
    const playBtn = card.querySelector<HTMLButtonElement>('[data-play-btn]');
    if (wrap && playBtn) {
      playBtn.addEventListener('click', () => {
        video.play().catch(() => {});
      });
      video.addEventListener('play', () => wrap.classList.add('is-playing'));
      video.addEventListener('pause', () => wrap.classList.remove('is-playing'));
    }
  });

  if ('IntersectionObserver' in window) {
    const playObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.5 }
    );

    document.querySelectorAll('.ba-video').forEach((v) => playObserver.observe(v));
  }
</script>
