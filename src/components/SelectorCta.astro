---
import { business } from '../data/business';

interface Props {
  heading: string;
  helper: string;
  options: string[];
  messageTemplate: string;
  placeholder?: string;
}

const { heading, helper, options, messageTemplate, placeholder = 'Selecione' } = Astro.props;
---

<section class="section selector-section">
  <div class="container">
    <div class="selector-card surface reveal">
      <h2>{heading}</h2>
      <p>{helper}</p>

      <form class="selector-form" data-selector-form data-template={messageTemplate}>
        <select required aria-label={heading}>
          <option value="" disabled selected>{placeholder}</option>
          {options.map((option) => (
            <option value={option}>{option}</option>
          ))}
        </select>

        <button type="submit" class="btn btn-primary btn-block">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3a9 9 0 0 0-7.75 13.55L3 21l4.6-1.2A9 9 0 1 0 12 3Zm5.2 12.9c-.2.6-1.2 1.2-1.7 1.3-.4.1-1 .2-3.1-.7-2.6-1.1-4.3-3.7-4.4-3.9-.1-.2-1-1.4-1-2.6 0-1.2.6-1.8.9-2.1.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.6.7 1.8s0 .3-.1.5c-.1.2-.2.3-.4.5-.1.2-.3.3-.1.6.2.4.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.7 1.6.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1l1.7.8c.2.1.4.2.5.3.1.2.1.9-.2 1.6Z"/>
          </svg>
          Pedir orçamento
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .selector-section {
    padding-top: 0;
  }

  .selector-card {
    max-width: 560px;
    padding: 40px;
  }

  .selector-card h2 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }

  .selector-card p {
    margin-bottom: 24px;
  }

  .selector-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .selector-form select {
    font-family: inherit;
    font-size: 0.95rem;
    padding: 13px 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
  }

  .selector-form select:invalid {
    color: var(--ink-2);
  }
</style>

<script define:vars={{ waBase: business.whatsappBase }}>
  document.querySelectorAll('[data-selector-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const select = form.querySelector('select');
      const value = select.value;
      if (!value) return;

      const template = form.dataset.template;
      const message = template.replace('{option}', value);
      const url = `${waBase}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  });
</script>
