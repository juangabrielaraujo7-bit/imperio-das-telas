---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Um pouco do nosso dia a dia',
  text = 'Aparelho aberto na bancada, peça de qualidade e conferência antes de fechar. É assim que trabalhamos todo reparo que sai daqui.',
} = Astro.props;

const items = [
  { type: 'photo', file: '/img/loja/loja-interior.jpg', alt: 'Interior da loja Império das Telas na Freguesia do Ó', caption: 'Nossa loja' },
  { type: 'video', file: '/videos/bancada-servico.mp4', poster: '/img/videos/bancada-servico.jpg', alt: 'Técnico reparando celular na bancada da Império das Telas', caption: 'Reparo na bancada' },
  { type: 'photo', file: '/img/loja/loja-fachada-dia.jpg', alt: 'Fachada da loja Império das Telas na Freguesia do Ó', caption: 'Fachada da loja' },
] as const;
---

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>

    <div class="grid grid-3">
      {items.map((item, i) => (
        <div class="photo surface reveal reveal-scale" style={`--reveal-delay: ${i * 90}ms`} data-photo data-video-card={item.type === 'video' ? true : undefined}>
          {item.type === 'video' ? (
            <video
              class="media-content"
              muted
              loop
              playsinline
              preload="metadata"
              poster={item.poster}
              data-src={item.file}
            >
              <source src={item.file} type="video/mp4" />
            </video>
          ) : (
            <img class="media-content" src={item.file} alt={item.alt} loading="lazy" width="480" height="360" />
          )}
          <span class="photo-fallback" data-photo-fallback>{item.type === 'video' ? 'Vídeo em breve' : 'Foto em breve'}</span>
          <span class="photo-caption">{item.caption}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 0;
  }

  .media-content {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .photo:hover .media-content {
    transform: scale(1.06);
  }

  .photo-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--silver);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .photo.no-media .media-content {
    display: none;
  }

  .photo.no-media .photo-fallback {
    display: flex;
  }

  .photo-caption {
    position: absolute;
    left: 16px;
    bottom: 14px;
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .photo.no-media .photo-caption {
    color: var(--ink-2);
    text-shadow: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-photo]').forEach((card) => {
    const media = card.querySelector<HTMLImageElement | HTMLVideoElement>('.media-content');
    if (!media) return;

    const markNoMedia = () => card.classList.add('no-media');

    if (media instanceof HTMLVideoElement) {
      media.addEventListener('error', markNoMedia, { once: true });

      // Checking networkState right away is unreliable: the browser may not
      // have started (or finished) the resource selection algorithm yet,
      // especially for an off-screen video, which produced false positives.
      // Give it a few seconds to genuinely fail before treating it as missing.
      setTimeout(() => {
        const stillNothing = media.readyState === HTMLMediaElement.HAVE_NOTHING;
        const gaveUp = media.networkState === HTMLMediaElement.NETWORK_NO_SOURCE;
        if (media.error || (stillNothing && gaveUp)) markNoMedia();
      }, 5000);
    } else {
      if (media.complete && media.naturalWidth === 0) {
        markNoMedia();
        return;
      }
      media.addEventListener('error', markNoMedia, { once: true });
    }
  });

  if ('IntersectionObserver' in window) {
    const playObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.5 }
    );

    document.querySelectorAll<HTMLVideoElement>('[data-video-card] video').forEach((v) => playObserver.observe(v));
  }
</script>
