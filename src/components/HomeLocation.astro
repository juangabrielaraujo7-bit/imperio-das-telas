---
import { business, whatsappLink } from '../data/business';
import Icon from './Icon.astro';

const photos = [
  { file: 'loja-interior.jpg', alt: 'Interior da loja Império das Telas na Freguesia do Ó' },
  { file: 'loja-fachada-dia.jpg', alt: 'Fachada da loja Império das Telas durante o dia' },
  { file: 'loja-fachada-noite.jpg', alt: 'Fachada da loja Império das Telas à noite' },
];
---

<section class="section" id="localizacao">
  <div class="container">
    <div class="location-grid">
      <div class="location-copy reveal">
        <span class="eyebrow">Localização</span>
        <h2>Venha nos visitar na Freguesia do Ó</h2>

        <ul class="info-list">
          <li>
            <Icon name="pin" size={20} />
            <span>{business.addressStreet}, {business.neighborhood}, {business.city} - {business.state}, {business.zip}</span>
          </li>
          <li>
            <Icon name="clock" size={20} />
            <span>{business.hours}</span>
          </li>
          <li>
            <Icon name="phone" size={20} />
            <span>{business.phoneDisplay}</span>
          </li>
        </ul>

        <a class="btn btn-whatsapp" href={whatsappLink('Olá! Vim pelo site e gostaria de saber como chegar até a loja.')} target="_blank" rel="noopener noreferrer nofollow">
          <Icon name="whatsapp" size={18} />
          Chamar no WhatsApp
        </a>
      </div>

      <div class="map-frame surface reveal">
        <iframe
          src={business.mapsEmbedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localização da Império das Telas no Google Maps"
          aria-label="Mapa com a localização da Império das Telas"
        ></iframe>
      </div>
    </div>

    <div class="location-photos">
      {photos.map((photo, i) => (
        <div class="location-photo surface reveal reveal-scale" style={`--reveal-delay: ${i * 90}ms`} data-photo>
          <img src={`/img/loja/${photo.file}`} alt={photo.alt} loading="lazy" width="480" height="360" />
          <span class="photo-fallback" data-photo-fallback>Foto em breve</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 28px 0 32px;
  }

  .info-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--ink-2);
  }

  .info-list :global(svg) {
    flex-shrink: 0;
    color: var(--silver);
    margin-top: 2px;
  }

  .map-frame {
    overflow: hidden;
    padding: 0;
    aspect-ratio: 4 / 3;
  }

  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .location-photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .location-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 0;
  }

  .location-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .location-photo:hover img {
    transform: scale(1.06);
  }

  .photo-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--silver);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .location-photo.no-media img {
    display: none;
  }

  .location-photo.no-media .photo-fallback {
    display: flex;
  }

  @media (max-width: 900px) {
    .location-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .location-photos {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-photo]').forEach((card) => {
    const img = card.querySelector('img');
    if (!img) return;

    const markNoMedia = () => card.classList.add('no-media');

    if (img.complete && img.naturalWidth === 0) {
      markNoMedia();
      return;
    }

    img.addEventListener('error', markNoMedia, { once: true });
  });
</script>
